# PostgreSQL connection string (the bot and scheduler use the same DB).
DATABASE_URL="postgresql://telegram_reminders_app:CHANGE_ME@127.0.0.1:5432/telegram_reminders"

# Telegram bot token from @BotFather.
TELEGRAM_BOT_TOKEN="123456789:replace-with-token-from-botfather"

# "polling" (default, recommended for a single VPS) or "webhook".
BOT_MODE="polling"

# Required only when BOT_MODE=webhook.
# TELEGRAM_WEBHOOK_SECRET="change-me-to-a-long-random-string"

# Optional HTTP endpoints (only if you also run the Next.js server).
# CRON_SECRET="change-me-to-a-long-random-string"
# APP_BASE_URL="https://example.com"

# Optional tuning (defaults shown).
# LOG_LEVEL="info"
# REMINDER_BATCH_SIZE="25"
# DELIVERY_BATCH_SIZE="50"
# MAX_DELIVERY_ATTEMPTS="5"
